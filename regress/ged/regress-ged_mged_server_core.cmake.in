# Values set at CMake configure time 
set(CBDIR "@CMAKE_CURRENT_BINARY_DIR@")
set(CSDIR "@CMAKE_CURRENT_SOURCE_DIR@")
set(LOGFILE "${CBDIR}/regress-ged_mged_server_core.log")

file(WRITE "${LOGFILE}" "Starting mged_server_core test run\n")

# The executable locations aren't know at CMake configure time, so it is passed
# in via the EXEC variable at runtime by a generator expression in the parent
# build.  De-quote it and assign it to an appropriate variable.
string(REPLACE "\\" "" CORE_EXEC "${EXEC}")
if(NOT EXISTS "${CORE_EXEC}")
  file(WRITE "${LOGFILE}" "mged_server_core test program not found at location \"${CORE_EXEC}\" - aborting\n")
  file(READ "${LOGFILE}" LOG)
  message(FATAL_ERROR "Unable to find mged_server_core test program, aborting.\nSee ${LOGFILE} for more details.\n${LOG}")
endif(NOT EXISTS "${CORE_EXEC}")

# Run server core tests
file(APPEND "${LOGFILE}" "Running ${CORE_EXEC} all\n")
execute_process(
  COMMAND "${CORE_EXEC}" "all"
  RESULT_VARIABLE core_result
  OUTPUT_VARIABLE core_log
  ERROR_VARIABLE core_log
  WORKING_DIRECTORY ${CBDIR}
)
file(APPEND "${LOGFILE}" "${core_log}")
if(core_result)
  file(READ "${LOGFILE}" LOG)
  message(FATAL_ERROR "[regress-ged_mged_server_core] Failure: ${core_result}. See ${LOGFILE} for more info.\n${LOG}")
endif(core_result)

# Run individual tests for detailed output
set(TEST_NAMES init socket client buffer poll error)
foreach(test_name ${TEST_NAMES})
  file(APPEND "${LOGFILE}" "Running ${CORE_EXEC} ${test_name}\n")
  execute_process(
    COMMAND "${CORE_EXEC}" "${test_name}"
    RESULT_VARIABLE core_result
    OUTPUT_VARIABLE core_log
    ERROR_VARIABLE core_log
    WORKING_DIRECTORY ${CBDIR}
  )
  file(APPEND "${LOGFILE}" "${core_log}")
  if(core_result)
    file(READ "${LOGFILE}" LOG)
    message(FATAL_ERROR "[regress-ged_mged_server_core] Failure in ${test_name}: ${core_result}. See ${LOGFILE} for more info.\n${LOG}")
  endif(core_result)
endforeach(test_name)

file(APPEND "${LOGFILE}" "All mged_server_core tests completed successfully\n")

